[0.001, "o", "================================================================================\r\n       http_logviewer: Configuration & State Models (Phase 01 / Category C)     \r\n================================================================================\r\n\r\n"]
[0.251, "o", "[1] Default Production Configuration (defaultViewerConfig):\r\n  Log Source:         -\r\n  Output Format:      stream_table\r\n  Log Format:         auto\r\n  Color Mode:         auto (colorOutput = true)\r\n  Live Follow:        false\r\n  Multi-IP Grouping:  false\r\n"]
[0.000, "o", "  Correlation Window: 1800s\r\n  Valid?:             true\r\n\r\n"]
[0.300, "o", "[2] Granular Filtering Criteria (FilterCriteria):\r\n  Criteria:           FilterCriteria(minThreatScore: 50, statusWhitelist: @[401, 403, 404, 500], countryWhitelist: @[\"US\", \"DE\", \"NL\"], categories: {SUSPICIOUS, BAD_ACTOR_HACKER})\r\n  Allows Status 404:  true\r\n  Allows Status 200:  false\r\n  Allows Country 'NL':true\r\n  Allows Country 'CN':false\r\n  Allows Threat 85:   true\r\n  Allows Threat 25:   false\r\n\r\n"]
[0.300, "o", "[3] Request Matching against Filter Criteria:\r\n  Incoming Request:   185.220.101.5 [🇳🇱 NL] -> 404 /wp-login.php\r\n  Matches Criteria?:  true\r\n\r\n"]
[0.300, "o", "[4] CLI Argument Parsing & Conversion (parseCommandLine):\r\n  Input CLI Tokens:   [\"-f\", \"--filter=hacker\", \"--min-score=70\", \"--status=404,500\", \"--group-actors\", \"--format=json\", \"/var/log/nginx/access.log\"]\r\n  Parsed Log File:    /var/log/nginx/access.log\r\n  Live Follow (-f):   true\r\n  Min Threat Score:   70\r\n  Filter Category:    BAD_ACTOR_HACKER\r\n  Status Filter:      @[404, 500]\r\n  Multi-IP Grouping:  true\r\n  Output Format:      json\r\n\r\n"]
[0.300, "o", "[5] JSON Configuration Serialization & Deserialization:\r\n  Serialized JSON:    \r\n    {\r\n      \"logFilePath\": \"/var/log/nginx/access.log\",\r\n      \"follow\": true,\r\n      \"colorOutput\": true,\r\n      \"colorMode\": \"auto\",\r\n      \"outputFormat\": \"json\",\r\n      \"logFormat\": \"auto\",\r\n      \"filterCategory\": \"BAD_ACTOR_HACKER\",\r\n      \"minThreatScore\": 70,\r\n      \"statusCodeFilter\": [\r\n        404,\r\n        500\r\n      ],\r\n      \"geoDbPath\": null,\r\n"]
[0.000, "o", "      \"enableGrouping\": true,\r\n      \"correlationWindowSeconds\": 1800,\r\n      \"filters\": {\r\n        \"minThreatScore\": 70,\r\n        \"statusWhitelist\": [\r\n          404,\r\n          500\r\n        ],\r\n"]
