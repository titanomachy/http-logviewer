[0.000, "o", "        \"countryWhitelist\": [],\r\n        \"countryBlacklist\": [],\r\n        \"categories\": [\r\n          \"BAD_ACTOR_HACKER\"\r\n        ],\r\n        \"categoryFilter\": \"BAD_ACTOR_HACKER\"\r\n      }\r\n    }\r\n"]
[0.000, "o", "  Round-Trip Match?:  true\r\n\r\n"]
